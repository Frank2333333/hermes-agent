# Hermes Agent Enterprise Intranet Environment
# This branch is intentionally locked to local/self-hosted services only.

# =============================================================================
# SELF-HOSTED MODEL ENDPOINT
# =============================================================================
# Point Hermes at an OpenAI-compatible model gateway that is reachable only
# on localhost, a private network, or an enterprise allowlisted address.
# Examples:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_BASE_URL=http://192.168.1.20:8000/v1
# OPENAI_BASE_URL=https://llm-gateway.intra.example.com/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Optional. Leave unset for local servers that do not require auth.
# OPENAI_API_KEY=

# =============================================================================
# SELF-HOSTED WEB EXTRACTION / CRAWL
# =============================================================================
# Enterprise mode disables public search/extract providers. If you want
# web_extract / web_crawl, point Hermes at a self-hosted Firecrawl instance.
# FIRECRAWL_API_URL=http://127.0.0.1:3002
# FIRECRAWL_API_KEY=

# =============================================================================
# INTERNAL ENTRYPOINTS
# =============================================================================
# API server
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8080
# API_SERVER_KEY=

# =============================================================================
# TERMINAL TOOL
# =============================================================================
# Terminal backend is usually configured in config.yaml. These are optional
# overrides if you need them in the environment.
# TERMINAL_ENV=local
# TERMINAL_TIMEOUT=180
# TERMINAL_CWD=.

# =============================================================================
# NOTES
# =============================================================================
# Public/cloud model providers and consumer messaging integrations are removed
# from this branch by design.
